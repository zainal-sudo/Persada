PORT=3089

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_finance_db

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# ── AI Assistant (9Router) ──
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=
AI_MODEL=bsmchat
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=90000
# Mode agen (function calling) — off = pipeline lama (rule-based intent)
AI_AGENT=on
AI_AGENT_MAX_ITER=8
AI_AGENT_MODEL=
# Akses widget/endpoint AI
AI_ALLOWED_KODES=FINANCE,OWNER,MGR
# Akses HPP/Margin/Lastcost (laporan & AI tool)
FINANCE_ALLOWED_KODES=FINANCE
# Boleh memilih cabang Pusat
BRANCH_ALLOWED_KODES=FINANCE,OWNER
# User yang boleh pakai AI + lihat HPP/Margin + lintas cabang
AI_ALLOWED_KODES=FINANCE,OWNER
